# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Secrets — never commit
.env
.env.*
*.key
*.pem
*.p12

# OS / editors
.DS_Store
.idea/
.vscode/

# Local artifacts
tmp/
*.log
bench_reports/
bench_cache/

# M6 persistent token stores (SR-026: mappings never committed)
*.vault
*.vault.tmp

# Debug dashboard (tools/dashboard) — it never writes, but a future
# edit or a manual dump must not be able to commit a token mapping.
# Deliberately NOT a blanket *.html: that would silently untrack
# tools/dashboard/page.html and docs/gateway_example.html.
tools/dashboard/_dumps/
*-dashboard.json
*.mapping.json

# Claude Code local session state
.claude/
