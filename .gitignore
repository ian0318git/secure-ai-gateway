# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Secrets — never commit
.env
.env.*
*.key
*.pem
*.p12

# OS / editors
.DS_Store
.idea/
.vscode/

# Local artifacts
tmp/
*.log
# Benchmark outputs are generated, but the report carrying the SR-015
# acceptance evidence MUST be committed: the M5 evidence test
# re-verifies it, and a test cannot verify a file a fresh clone does
# not have. Note the form — excluding the DIRECTORY would defeat the
# negations below, because git cannot re-include a file whose parent
# directory is excluded. Anything else the benchmark writes stays
# ignored.
bench_reports/*
!bench_reports/benchmark_report.json
!bench_reports/benchmark_report.md
bench_cache/

# M6 persistent token stores (SR-026: mappings never committed)
*.vault
*.vault.tmp

# Debug dashboard (tools/dashboard) — it never writes, but a future
# edit or a manual dump must not be able to commit a token mapping.
# Deliberately NOT a blanket *.html: that would silently untrack
# tools/dashboard/page.html and docs/gateway_example.html.
tools/dashboard/_dumps/
*-dashboard.json
*.mapping.json

# Claude Code local session state
.claude/
