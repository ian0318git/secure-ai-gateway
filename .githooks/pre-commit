#!/usr/bin/env bash
# Pre-commit gate — fail closed on lint / type / security / test
# failures.  Exit 1 aborts the commit; the escape hatch is git's own
# `git commit --no-verify` (use only for emergency doc commits).
#
# Enable per clone:  git config core.hooksPath .githooks
# Requires the dev tools:  uv pip install -e '.[dev]'
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
VENV=".venv/bin"

# --- 1. Token mappings can never be committed (CLAUDE.md §2, SR-002).
# Covers the M6 stores, the debug dashboard's accidental dumps, and the
# M6 store's temporary file.
if git diff --cached --name-only --diff-filter=ACMR \
    | grep -qE '(\.vault(\.tmp)?|-dashboard\.json|\.mapping\.json)$'; then
    echo "pre-commit: refusing to commit a token mapping" \
         "(*.vault | *-dashboard.json | *.mapping.json)" >&2
    exit 1
fi

# --- 2. Anything Python-ish gets the full gate.
#
# The set that DECIDES whether to run is wider than the set that gets
# LINTED.  Keying only on '*.py' left a hole: staging just
# tools/dashboard/page.html skipped every gate including pytest, and
# that file is where the CSP and the no-HTML-sink rules live.
PY_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
TOOL_FILES=$(git diff --cached --name-only --diff-filter=ACM -- tools)
if [ -z "$PY_FILES" ] && [ -z "$TOOL_FILES" ]; then
    echo "pre-commit: no Python files staged — OK"
    exit 0
fi

if [ ! -x "$VENV/ruff" ]; then
    echo "pre-commit: $VENV/ruff missing — run: uv pip install -e '.[dev]'" >&2
    exit 1
fi

# --- 3. Ruff on the staged Python files only ($PY_FILES can be empty
# when only a non-.py file under tools/ was staged — ruff must not be
# handed page.html).
if [ -n "$PY_FILES" ]; then
    echo "pre-commit: ruff ($(printf '%s\n' "$PY_FILES" | wc -l) file(s))"
    # shellcheck disable=SC2086  # intentional word-splitting of file list
    "$VENV/ruff" check $PY_FILES
else
    echo "pre-commit: ruff — no .py staged, skipped"
fi

# --- 4. Bandit on staged src/tools files (tests carry deliberate decoys).
SRC_FILES=$(printf '%s\n' "$PY_FILES" | grep -E '^(src|tools)/' || true)
if [ -n "$SRC_FILES" ]; then
    echo "pre-commit: bandit"
    # shellcheck disable=SC2086  # intentional word-splitting of file list
    "$VENV/bandit" -q $SRC_FILES
fi

# --- 5. Mypy on the whole src + tools surface (cross-file contracts).
echo "pre-commit: mypy"
"$VENV/mypy" src tools

# --- 6. Full test suite (unit + security + tools).
echo "pre-commit: pytest"
"$VENV/python" -m pytest tests -q

echo "pre-commit: OK"
